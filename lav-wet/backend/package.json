{
  "name": "lavanderia-backend",
  "version": "1.0.0",
  "description": "Backend serverless para sistema de guías de lavandería",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && webpack",
    "build:serverless": "webpack",
    "start": "node dist/index.js",
    "migrate": "tsx src/database/migrate.ts",
    "vercel-build": "npm run build",
    "sls:dev": "serverless offline",
    "sls:deploy": "serverless deploy",
    "sls:deploy:prod": "serverless deploy --stage prod",
    "sls:remove": "serverless remove",
    "sls:logs": "serverless logs -f api -t",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@vendia/serverless-express": "^4.12.6",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.6.5",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.130",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.9.0",
    "serverless": "^3.38.0",
    "serverless-dotenv-plugin": "^6.0.0",
    "serverless-offline": "^13.3.0",
    "serverless-prune-plugin": "^2.0.2",
    "serverless-webpack": "^5.13.0",
    "ts-loader": "^9.5.1",
    "tsx": "^4.6.0",
    "typescript": "^5.2.2",
    "webpack": "^5.89.0",
    "webpack-node-externals": "^3.0.0"
  }
}
