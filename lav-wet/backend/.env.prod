# Configuración de Producción para AWS Lambda

# Base de datos (por ahora usaremos datos simulados)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=lavanderia_prod
DB_USER=admin
DB_PASSWORD=password_temporal

# Autenticación
JWT_SECRET=jwt_secret_extremadamente_seguro_para_produccion_con_al_menos_64_caracteres_aqui
JWT_EXPIRES_IN=24h

# Servidor
NODE_ENV=production

# CORS (actualizarás esto con tu dominio frontend)
CORS_ORIGIN=*

# Logging
LOG_LEVEL=warn

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100