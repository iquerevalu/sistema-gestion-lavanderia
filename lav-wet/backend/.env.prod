# Configuración para producción
NODE_ENV=production

# Base de datos (usar variables de AWS Systems Manager o Secrets Manager)
DB_HOST=${ssm:/lavanderia/prod/db/host}
DB_PORT=3306
DB_NAME=${ssm:/lavanderia/prod/db/name}
DB_USER=${ssm:/lavanderia/prod/db/user}
DB_PASSWORD=${ssm:/lavanderia/prod/db/password}

# Autenticación
JWT_SECRET=${ssm:/lavanderia/prod/jwt/secret}
JWT_EXPIRES_IN=24h

# CORS
CORS_ORIGIN=https://lavanderia-system.com

# Logging
LOG_LEVEL=warn

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100